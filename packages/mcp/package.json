{
  "name": "@artblocks/abx-mcp",
  "version": "0.0.0",
  "description": "Local stdio MCP server for the ABX CLI: capabilities, doctor, testnet deploy dry runs and unsigned transactions. Never signs or sends.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "homepage": "https://docs.abx.io",
  "bugs": "https://github.com/ArtBlocks/abx/issues",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtBlocks/abx.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "abx",
    "mcp",
    "model-context-protocol",
    "art-blocks",
    "nft"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "bin": {
      "abx-mcp": "./dist/bin.js"
    },
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@artblocks/abx-cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.6"
  }
}
